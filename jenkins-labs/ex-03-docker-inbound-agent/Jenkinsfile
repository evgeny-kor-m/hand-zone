pipeline {
    agent { label 'docker-inbound-agent-label' }
    environment {
             DOCKERHUB_CREDENTIALS = credentials('DOCKERHUB-CRED')    }
    stages {
        stage('Print PAT username') {
            steps {
                sh 'echo "GitHub username: $DOCKERHUB_CREDENTIALS_USR"'
                sh 'echo "GitHub password: $DOCKERHUB_CREDENTIALS_PSW"'  }}
        stage('my home directory') {
            steps {
                sh "pwd"
            }
        }
        stage('show files') {
            steps {
                sh "ls -la"
            }
        }
        stage('docker version') {
            steps {
                sh "docker --version"
            }
        }
        stage('docker pull') {
            steps {
                sh "docker pull nginx:latest"
            }
        }
        stage('docker ps') {
            steps {
                sh "docker ps"
            }
        }
        stage('remove docker-nginx') {
            steps {
                sh "docker rm -f docker-nginx | true"
            }
        }
        stage('docker ps2') {
            steps {
                sh "docker ps"
            }
        }
        stage('show docker images') {
            steps {
                sh "docker images"
            }
        }
        stage('docker run') {
            steps {
                sh "docker run --name docker-nginx -d -p 8000:80 nginx:latest"
            }
        }
        stage('Test NGINX') {
            steps {
                sh "curl -f http://172.17.0.1:8000 || exit 1"
            }
        }
        stage('login to docker-hub') {
            steps {
                sh 'echo "$DOCKERHUB_CREDENTIALS_PSW" | docker login -u "$DOCKERHUB_CREDENTIALS_USR" --password-stdin'
            }
        }
        stage('Tag image and push it to docker-hub') {
            steps {
                sh "docker tag  dind-inbound-agent-img  evgenykorchev/dind-inbound-agent-img:v01"
                sh "docker push evgenykorchev/dind-inbound-agent-img:v01"
            }
        }





    }
}